{
  "name": "pc-uni-h5",
  "version": "1.0.0",
  "description": "Multi-project workspace with myEditor (Vue3) and myViewer (uni-app)",
  "scripts": {
    "dev": "concurrently \"node message-server.js\" \"pnpm run dev:editor\" \"pnpm run dev:viewer\"",
    "dev:all": "concurrently \"node message-server.js\" \"pnpm run dev:editor\" \"pnpm run dev:viewer\" \"pnpm run dev:flow\"",
    "dev:editor": "pnpm --filter myeditor run dev",
    "dev:viewer": "pnpm --filter myviewer run dev",
    "dev:flow": "pnpm --filter flow run dev",
    "dev:server": "pnpm --filter @pc-uni-h5/server run dev",
    "server": "node message-server.js",
    "dev:utils": "pnpm --filter @pc-uni-h5/utils run dev",
    "build:utils": "pnpm --filter @pc-uni-h5/utils run build",
    "build:utils:no-sourcemap": "pnpm --filter @pc-uni-h5/utils run build:no-sourcemap",
    "build:editor": "pnpm --filter myeditor run build",
    "build:viewer": "pnpm --filter myviewer run build:h5",
    "build:viewer:h5": "pnpm --filter myviewer run build:h5",
    "build:viewer:mp-weixin": "pnpm --filter myviewer run build:mp-weixin",
    "build:flow": "pnpm --filter flow run build",
    "build:all": "pnpm run build:editor && pnpm run build:viewer && pnpm run build:flow"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
